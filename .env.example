# Copiar como .env y cambiar los valores. El archivo .env NO se sube a Git.

POSTGRES_DB=ferretech
POSTGRES_USER=ferretech
POSTGRES_PASSWORD=cambia-esta-clave

# Secreto para firmar los JWT. Mínimo 32 caracteres. Generar uno con:  openssl rand -base64 48
APP_JWT_SECRET=cambia-este-secreto-por-uno-largo-de-al-menos-32-caracteres

# ":80" = HTTP por IP pública. Con dominio, poner el dominio (ej. tienda.ejemplo.cl) y Caddy activa HTTPS.
SITE_ADDRESS=:80

# Puerto del backend publicado solo en 127.0.0.1 (pruebas con curl o con el frontend local).
BACKEND_PORT=8080

# Orígenes que pueden llamar a la API desde otro dominio (solo hace falta en desarrollo local).
# En producción el frontend y la API comparten origen, así que no influye.
APP_CORS_ORIGINS=*

# Contraseñas de las cuentas de prueba que se crean al iniciar la primera vez (Mauricio y Admin).
APP_SEED_PASSWORD_CLIENTE=1234
APP_SEED_PASSWORD_ADMIN=1234

# true = el código de recuperación se muestra en pantalla (simulación de correo). Poner false si se integra un correo real.
APP_RECUPERACION_MOSTRAR_CODIGO=true
